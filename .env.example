# ============================================================================
# LAKE FLAVOUR — environment variables (TEMPLATE — names only, no values).
# Copy to .env.local and fill in. .env.local is gitignored: NEVER commit it.
# ============================================================================

# --- Supabase (DEV project: https://supabase.com/dashboard) -----------------
# Public values — safe in the browser bundle (readable by anyone).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY — bypasses Row Level Security. Never expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend: https://resend.com) --------------------------------------
RESEND_API_KEY=
# From address for notifications. Default: Lake Flavour <onboarding@resend.dev>
RESEND_FROM=
# Set to true ONLY after verifying a sending domain (allows emailing customers).
RESEND_SEND_TO_CUSTOMERS=
# Optional: override the Resend API base URL (tests point it at a local mock).
RESEND_API_BASE_URL=

# --- People -------------------------------------------------------------------
# Where new-order notifications are sent.
OWNER_EMAIL=
# Comma-separated emails that may open /admin (magic-link sign-in).
# Example: OWNER_EMAIL=owner@example.com, ADMIN_EMAILS=owner@example.com
ADMIN_EMAILS=

# --- Site ----------------------------------------------------------------------
# Absolute URL used in email links and Open Graph tags (no trailing slash).
NEXT_PUBLIC_SITE_URL=

# --- Local development / tests ONLY --------------------------------------------
# Direct Postgres connection (postgres.js transport). Supabase projects do not
# need this; it powers the local test suite (see README "Testing").
DATABASE_URL=
